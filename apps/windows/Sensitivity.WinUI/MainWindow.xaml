<Window
    x:Class="Sensitivity.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Grid x:Name="Root">
        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,138,0" IsTabStop="False">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Width="28" Height="28" CornerRadius="9" VerticalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}"><Image Source="ms-appx:///Assets/SensitivityIcon.png" Stretch="Uniform" Margin="4" /></Border>
            <TextBlock Grid.Column="1" Margin="10,0,0,0" Tag="app.title" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Margin="8,0,0,0" Tag="app.tagline" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
            <Button Grid.Column="3" x:Name="TitleRefreshButton" Click="RefreshButton_Click" Style="{StaticResource IconActionButtonStyle}" AutomationProperties.Name="action.refresh"><FontIcon Glyph="&#xE72C;" /></Button>
        </Grid>
        <controls:NavigationView x:Name="Navigation" Grid.Row="1" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" PaneDisplayMode="Auto" CompactModeThresholdWidth="820" ExpandedModeThresholdWidth="1180" OpenPaneLength="256" SelectionChanged="Navigation_SelectionChanged">
            <controls:NavigationView.MenuItems>
                <controls:NavigationViewItem AutomationProperties.Name="nav.overview" Tag="overview"><controls:NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></controls:NavigationViewItem.Icon></controls:NavigationViewItem>
                <controls:NavigationViewItem AutomationProperties.Name="nav.flash" Tag="flash"><controls:NavigationViewItem.Icon><FontIcon Glyph="&#xE898;" /></controls:NavigationViewItem.Icon></controls:NavigationViewItem>
                <controls:NavigationViewItem AutomationProperties.Name="nav.recovery" Tag="recovery"><controls:NavigationViewItem.Icon><FontIcon Glyph="&#xE90F;" /></controls:NavigationViewItem.Icon></controls:NavigationViewItem>
                <controls:NavigationViewItem AutomationProperties.Name="nav.diagnostics" Tag="diagnostics"><controls:NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></controls:NavigationViewItem.Icon></controls:NavigationViewItem>
            </controls:NavigationView.MenuItems>
            <Grid>
                <controls:InfoBar x:Name="StatusBar" Margin="24,16,24,0" VerticalAlignment="Top" IsOpen="False" IsClosable="True" />
                <ScrollViewer x:Name="OverviewPage" Padding="32,76,32,40" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="1120" Spacing="24">
                        <StackPanel Spacing="6"><TextBlock Tag="page.overview" Style="{StaticResource PageTitleStyle}" /><TextBlock Tag="page.overview_intro" Style="{StaticResource CaptionStyle}" MaxWidth="760" /></StackPanel>
                        <Border Style="{StaticResource HeroCardStyle}"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="56" Height="56" CornerRadius="28" Background="{ThemeResource AccentFillColorDefaultBrush}"><FontIcon Glyph="&#xE7F8;" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock x:Name="ConnectionTitle" Tag="connection.none" Style="{StaticResource SectionTitleStyle}" /><TextBlock x:Name="ConnectionSubtitle" Tag="connection.refresh_hint" Style="{StaticResource CaptionStyle}" /></StackPanel><Button Grid.Column="2" x:Name="RefreshButton" Click="RefreshButton_Click" Style="{StaticResource IconActionButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" /><TextBlock Tag="action.refresh" /></StackPanel></Button></Grid></Border>
                        <Grid x:Name="OverviewCards" ColumnSpacing="20" RowSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="16"><TextBlock Tag="section.selected_recovery" Style="{StaticResource SectionTitleStyle}" /><ComboBox x:Name="DevicePicker" Tag="label.usb_interface" DisplayMemberPath="DisplayName" SelectionChanged="DevicePicker_SelectionChanged" /><Button x:Name="ReadInfoButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Click="ReadInfoButton_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE9D9;" /><TextBlock Tag="action.read_device" /></StackPanel></Button><Grid RowSpacing="12" ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Tag="label.device" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Grid.Column="1" x:Name="DeviceNameText" Text="—" FontWeight="SemiBold" /><TextBlock Grid.Row="1" Tag="label.version" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Grid.Row="1" Grid.Column="1" x:Name="VersionText" Text="—" /><TextBlock Grid.Row="2" Tag="label.region" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Grid.Row="2" Grid.Column="1" x:Name="RegionText" Text="—" /><TextBlock Grid.Row="3" Tag="label.serial" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Grid.Row="3" Grid.Column="1" x:Name="SerialText" Text="—" FontFamily="Cascadia Mono,Consolas" /></Grid></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel Spacing="14"><TextBlock Tag="section.before_flash" Style="{StaticResource SectionTitleStyle}" /><TextBlock Tag="guide.rom" TextWrapping="Wrap" /><TextBlock Tag="guide.awake" TextWrapping="Wrap" /><TextBlock Tag="guide.wipe" TextWrapping="Wrap" /><Button HorizontalAlignment="Left" Click="GoToFlash_Click" Style="{StaticResource IconActionButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE898;" /><TextBlock Tag="action.choose_rom" /></StackPanel></Button></StackPanel></Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="FlashPage" Padding="32,76,32,40" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="900" Spacing="24"><StackPanel Spacing="6"><TextBlock Tag="page.flash" Style="{StaticResource PageTitleStyle}" /><TextBlock Tag="page.flash_intro" Style="{StaticResource CaptionStyle}" /></StackPanel><Border Style="{StaticResource CardStyle}"><StackPanel Spacing="16"><TextBlock Tag="section.recovery_rom" Style="{StaticResource SectionTitleStyle}" /><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="RomPathText" Tag="rom.none" IsReadOnly="True" /><Button Grid.Column="1" Tag="action.browse" Click="BrowseRomButton_Click" /></Grid><TextBlock Tag="rom.only_official" Style="{StaticResource CaptionStyle}" /></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel Spacing="16"><Grid><TextBlock Tag="section.flash_progress" Style="{StaticResource SectionTitleStyle}" /><TextBlock x:Name="ProgressPercentText" HorizontalAlignment="Right" /></Grid><TextBlock x:Name="OperationStatusText" Tag="status.ready" Style="{StaticResource CaptionStyle}" /><ProgressBar x:Name="FlashProgress" Minimum="0" Maximum="100" Value="0" Height="8" /><StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="StartFlashButton" Style="{StaticResource AccentButtonStyle}" Click="StartFlashButton_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE898;" /><TextBlock Tag="action.review_flash" /></StackPanel></Button><Button x:Name="CancelFlashButton" Tag="action.cancel_safely" IsEnabled="False" Click="CancelFlashButton_Click" /><ProgressRing x:Name="BusyRing" Width="24" Height="24" IsActive="False" /></StackPanel></StackPanel></Border></StackPanel></ScrollViewer>
                <ScrollViewer x:Name="RecoveryPage" Padding="32,76,32,40" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="900" Spacing="24"><StackPanel Spacing="6"><TextBlock Tag="page.recovery" Style="{StaticResource PageTitleStyle}" /><TextBlock Tag="page.recovery_intro" Style="{StaticResource CaptionStyle}" /></StackPanel><Border Style="{StaticResource CardStyle}"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Tag="section.reboot_phone" Style="{StaticResource SectionTitleStyle}" /><TextBlock Tag="reboot.exit_hint" Style="{StaticResource CaptionStyle}" /></StackPanel><Button Grid.Column="1" Tag="action.reboot" Click="RebootButton_Click" /></Grid></Border><Border Style="{StaticResource CardStyle}" BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Tag="section.erase_data" Style="{StaticResource SectionTitleStyle}" /><TextBlock Tag="erase.warning_short" Style="{StaticResource CaptionStyle}" /></StackPanel><Button Grid.Column="1" Tag="action.erase_data_short" Click="EraseDataButton_Click" /></Grid></Border></StackPanel></ScrollViewer>
                <ScrollViewer x:Name="DiagnosticsPage" Padding="32,76,32,40" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="900" Spacing="24"><StackPanel Spacing="6"><TextBlock Tag="page.diagnostics" Style="{StaticResource PageTitleStyle}" /><TextBlock Tag="page.diagnostics_intro" Style="{StaticResource CaptionStyle}" /></StackPanel><Border Style="{StaticResource CardStyle}"><StackPanel Spacing="16"><StackPanel Orientation="Horizontal" Spacing="10"><Button Style="{StaticResource AccentButtonStyle}" Tag="action.run_diagnostics" Click="RunDoctorButton_Click" /><Button Tag="action.copy_report" Click="CopyDiagnosticsButton_Click" /></StackPanel><TextBox x:Name="DiagnosticsText" Tag="diagnostics.none" MinHeight="300" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Mono,Consolas" /></StackPanel></Border></StackPanel></ScrollViewer>
                <ScrollViewer x:Name="SettingsPage" Padding="32,76,32,40" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="900" Spacing="24"><StackPanel Spacing="6"><TextBlock Tag="page.settings" Style="{StaticResource PageTitleStyle}" /><TextBlock Tag="page.settings_intro" Style="{StaticResource CaptionStyle}" /></StackPanel><Border Style="{StaticResource CardStyle}"><StackPanel Spacing="18"><ToggleSwitch x:Name="AutoResolveAdbToggle" Tag="setting.resolve_adb" IsOn="True" /><TextBlock Tag="setting.resolve_adb_hint" Style="{StaticResource CaptionStyle}" /><ToggleSwitch x:Name="StopAdbToggle" Tag="setting.stop_adb_always" IsOn="False" /><TextBlock Tag="setting.stop_adb_hint" Style="{StaticResource CaptionStyle}" /><ComboBox x:Name="LanguagePicker" Tag="label.language" SelectionChanged="LanguagePicker_SelectionChanged"><ComboBoxItem Tag="" AutomationProperties.Name="language.system" /><ComboBoxItem Tag="en" AutomationProperties.Name="language.english" /><ComboBoxItem Tag="hu" AutomationProperties.Name="language.hungarian" /><ComboBoxItem Tag="es" AutomationProperties.Name="language.spanish" /></ComboBox></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel Spacing="6"><TextBlock x:Name="AboutVersionText" Tag="app.title" Style="{StaticResource SectionTitleStyle}" /><TextBlock Tag="about.description" Style="{StaticResource CaptionStyle}" /></StackPanel></Border></StackPanel></ScrollViewer>
            </Grid>
        </controls:NavigationView>
    </Grid>
</Window>
