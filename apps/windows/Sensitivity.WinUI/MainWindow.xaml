<Window
    x:Class="Sensitivity.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Grid x:Name="Root">
        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,138,0" IsTabStop="False">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Width="28" Height="28" CornerRadius="9" VerticalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}"><Image Source="ms-appx:///Assets/SensitivityIcon.png" Stretch="Uniform" Margin="4" /></Border>
            <TextBlock Grid.Column="1" Margin="10,0,0,0" Tag="app.title" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Margin="8,0,0,0" Tag="app.tagline" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
            <Button Grid.Column="3" x:Name="TitleRefreshButton" Click="RefreshButton_Click" Style="{StaticResource TitleBarActionButtonStyle}" AutomationProperties.Name="action.refresh"><FontIcon Glyph="&#xE72C;" FontSize="14" /></Button>
        </Grid>
        <controls:NavigationView x:Name="Navigation" Grid.Row="1" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" PaneDisplayMode="Auto" CompactModeThresholdWidth="820" ExpandedModeThresholdWidth="1180" OpenPaneLength="256" SelectionChanged="Navigation_SelectionChanged">
            <controls:NavigationView.MenuItems>
                <controls:NavigationViewItem AutomationProperties.Name="nav.overview" Tag="overview"><controls:NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></controls:NavigationViewItem.Icon></controls:NavigationViewItem>
                <controls:NavigationViewItem AutomationProperties.Name="nav.flash" Tag="flash"><controls:NavigationViewItem.Icon><FontIcon Glyph="&#xE898;" /></controls:NavigationViewItem.Icon></controls:NavigationViewItem>
                <controls:NavigationViewItem AutomationProperties.Name="nav.roms" Tag="roms"><controls:NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;" /></controls:NavigationViewItem.Icon></controls:NavigationViewItem>
                <controls:NavigationViewItem AutomationProperties.Name="nav.recovery" Tag="recovery"><controls:NavigationViewItem.Icon><FontIcon Glyph="&#xE90F;" /></controls:NavigationViewItem.Icon></controls:NavigationViewItem>
                <controls:NavigationViewItem AutomationProperties.Name="nav.diagnostics" Tag="diagnostics"><controls:NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></controls:NavigationViewItem.Icon></controls:NavigationViewItem>
            </controls:NavigationView.MenuItems>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <controls:InfoBar x:Name="StatusBar" Grid.Row="0" Margin="24,8,24,0" MaxWidth="1100" HorizontalAlignment="Stretch" IsOpen="False" IsClosable="True" />
                <ScrollViewer x:Name="OverviewPage" Grid.Row="1" Padding="32,32,32,40" HorizontalContentAlignment="Left" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="1120" HorizontalAlignment="Stretch" Spacing="24">
                        <StackPanel Spacing="6"><TextBlock Tag="page.overview" Style="{StaticResource PageTitleStyle}" /><TextBlock Tag="page.overview_intro" Style="{StaticResource CaptionStyle}" MaxWidth="1000" /></StackPanel>
                        <Border Style="{StaticResource HeroCardStyle}"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="56" Height="56" CornerRadius="28" Background="{ThemeResource AccentFillColorDefaultBrush}"><FontIcon Glyph="&#xE7F8;" FontSize="24" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock x:Name="ConnectionTitle" Tag="connection.none" Style="{StaticResource SectionTitleStyle}" /><TextBlock x:Name="ConnectionSubtitle" Tag="connection.refresh_hint" Style="{StaticResource CaptionStyle}" /></StackPanel><Button Grid.Column="2" x:Name="RefreshButton" Click="RefreshButton_Click" Style="{StaticResource IconActionButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" /><TextBlock Tag="action.refresh" /></StackPanel></Button></Grid></Border>
                        <StackPanel Spacing="12"><TextBlock Tag="section.recovery_flow" Style="{StaticResource SectionTitleStyle}" /><TextBlock Tag="flow.intro" Style="{StaticResource CaptionStyle}" /><Border Style="{StaticResource CardStyle}"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="16" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Top"><TextBlock Text="1" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Spacing="14"><TextBlock Tag="flow.connect" Style="{StaticResource SectionTitleStyle}" /><TextBlock Tag="flow.connect_hint" Style="{StaticResource CaptionStyle}" /><ComboBox x:Name="DevicePicker" Tag="label.usb_interface" DisplayMemberPath="DisplayName" SelectionChanged="DevicePicker_SelectionChanged" /><StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="ReadInfoButton" Style="{StaticResource AccentButtonStyle}" Click="ReadInfoButton_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE9D9;" /><TextBlock Tag="action.read_device" /></StackPanel></Button><Button Tag="action.test_connection" Click="DetectButton_Click" /></StackPanel><Grid RowSpacing="8" ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Tag="label.device" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Grid.Column="1" x:Name="DeviceNameText" Text="—" FontWeight="SemiBold" /><TextBlock Grid.Row="1" Tag="label.version" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Grid.Row="1" Grid.Column="1" x:Name="VersionText" Text="—" /><TextBlock Grid.Row="2" Tag="label.region" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Grid.Row="2" Grid.Column="1" x:Name="RegionText" Text="—" /><TextBlock Grid.Row="3" Tag="label.serial" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Grid.Row="3" Grid.Column="1" x:Name="SerialText" Text="—" FontFamily="Cascadia Mono,Consolas" /></Grid></StackPanel></Grid></Border><Border Style="{StaticResource CardStyle}"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="16" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Top"><TextBlock Text="2" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Spacing="12"><TextBlock Tag="flow.package" Style="{StaticResource SectionTitleStyle}" /><TextBlock Tag="flow.package_hint" Style="{StaticResource CaptionStyle}" /><Button Style="{StaticResource AccentButtonStyle}" Tag="action.review_flash" Click="GoToFlash_Click" HorizontalAlignment="Left" /></StackPanel></Grid></Border></StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="FlashPage" Grid.Row="1" Padding="32,32,32,40" Visibility="Collapsed" HorizontalContentAlignment="Left" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="900" HorizontalAlignment="Left" Spacing="24"><StackPanel Spacing="6"><TextBlock Tag="page.flash" Style="{StaticResource PageTitleStyle}" /><TextBlock Tag="page.flash_intro" Style="{StaticResource CaptionStyle}" /></StackPanel><Border Style="{StaticResource CardStyle}"><StackPanel Spacing="16"><TextBlock Tag="section.recovery_rom" Style="{StaticResource SectionTitleStyle}" /><TextBlock Tag="rom.select_hint" Style="{StaticResource CaptionStyle}" /><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="RomPathText" Tag="rom.none" IsReadOnly="True" /><Button Grid.Column="1" Tag="action.browse" Click="BrowseRomButton_Click" /></Grid><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="DownloadDirectoryText" Tag="label.download_directory" IsReadOnly="True" /><Button Grid.Column="1" Tag="action.choose_folder" Click="ChooseDownloadFolderButton_Click" /></Grid><StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="DownloadLatestButton" Style="{StaticResource AccentButtonStyle}" Tag="action.download_latest" Click="DownloadLatestButton_Click" /><Button x:Name="FlashLatestButton" Tag="action.download_flash_latest" Click="FlashLatestButton_Click" /><Button Tag="action.find_zip" Click="FindDownloadedRomButton_Click" /></StackPanel><TextBlock Tag="latest_rom.warning" Style="{StaticResource CaptionStyle}" /></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel Spacing="16"><Grid><TextBlock Tag="section.flash_progress" Style="{StaticResource SectionTitleStyle}" /><TextBlock x:Name="ProgressPercentText" HorizontalAlignment="Right" /></Grid><TextBlock x:Name="OperationStatusText" Tag="status.ready" Style="{StaticResource CaptionStyle}" /><ProgressBar x:Name="FlashProgress" Minimum="0" Maximum="100" Value="0" Height="8" /><StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="StartFlashButton" Style="{StaticResource AccentButtonStyle}" Click="StartFlashButton_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE898;" /><TextBlock Tag="action.review_flash" /></StackPanel></Button><Button x:Name="CancelFlashButton" Tag="action.cancel_safely" IsEnabled="False" Click="CancelFlashButton_Click" /><ProgressRing x:Name="BusyRing" Width="24" Height="24" IsActive="False" /></StackPanel></StackPanel></Border></StackPanel></ScrollViewer>
                <ScrollViewer x:Name="RomsPage" Grid.Row="1" Padding="32,32,32,40" Visibility="Collapsed" HorizontalContentAlignment="Left" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="900" HorizontalAlignment="Left" Spacing="24"><StackPanel Spacing="6"><TextBlock Tag="page.roms" Style="{StaticResource PageTitleStyle}" /><TextBlock Tag="page.roms_intro" Style="{StaticResource CaptionStyle}" /></StackPanel><Border Style="{StaticResource CardStyle}"><StackPanel Spacing="14"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Tag="section.allowed_roms" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" /><Button Tag="action.refresh_allowed" Click="ListAllowedRomsButton_Click" /></StackPanel><TextBox x:Name="AllowedRomsText" Tag="allowed_roms.none" MinHeight="180" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Mono,Consolas" /></StackPanel></Border></StackPanel></ScrollViewer>
                <ScrollViewer x:Name="RecoveryPage" Grid.Row="1" Padding="32,32,32,40" Visibility="Collapsed" HorizontalContentAlignment="Left" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="900" HorizontalAlignment="Left" Spacing="24"><StackPanel Spacing="6"><TextBlock Tag="page.recovery" Style="{StaticResource PageTitleStyle}" /><TextBlock Tag="page.recovery_intro" Style="{StaticResource CaptionStyle}" /></StackPanel><Border Style="{StaticResource CardStyle}"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Tag="section.reboot_phone" Style="{StaticResource SectionTitleStyle}" /><TextBlock Tag="reboot.exit_hint" Style="{StaticResource CaptionStyle}" /></StackPanel><Button Grid.Column="1" Tag="action.reboot" Click="RebootButton_Click" /></Grid></Border><Border Style="{StaticResource CardStyle}" BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Tag="section.erase_data" Style="{StaticResource SectionTitleStyle}" /><TextBlock Tag="erase.warning_short" Style="{StaticResource CaptionStyle}" /></StackPanel><Button Grid.Column="1" Tag="action.erase_data_short" Click="EraseDataButton_Click" /></Grid></Border></StackPanel></ScrollViewer>
                <ScrollViewer x:Name="DiagnosticsPage" Grid.Row="1" Padding="32,32,32,40" Visibility="Collapsed" HorizontalContentAlignment="Left" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="900" HorizontalAlignment="Left" Spacing="24"><StackPanel Spacing="6"><TextBlock Tag="page.diagnostics" Style="{StaticResource PageTitleStyle}" /><TextBlock Tag="page.diagnostics_intro" Style="{StaticResource CaptionStyle}" /></StackPanel><Border Style="{StaticResource CardStyle}"><StackPanel Spacing="16"><StackPanel Orientation="Horizontal" Spacing="10"><Button Style="{StaticResource AccentButtonStyle}" Tag="action.test_connection" Click="DetectButton_Click" /><Button Tag="action.run_diagnostics" Click="RunDoctorButton_Click" /><Button Tag="action.copy_report" Click="CopyDiagnosticsButton_Click" /></StackPanel><TextBox x:Name="DiagnosticsText" Tag="diagnostics.none" MinHeight="300" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Mono,Consolas" /></StackPanel></Border></StackPanel></ScrollViewer>
                <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Padding="32,32,32,40" Visibility="Collapsed" HorizontalContentAlignment="Left" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="900" HorizontalAlignment="Left" Spacing="24">
        <StackPanel Spacing="6">
            <TextBlock Tag="page.settings" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Tag="page.settings_intro" Style="{StaticResource CaptionStyle}" />
        </StackPanel>
        <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="12">
                <TextBlock Tag="section.language" Style="{StaticResource SectionTitleStyle}" />
                <ComboBox x:Name="LanguagePicker" Tag="label.language" SelectionChanged="LanguagePicker_SelectionChanged">
                    <ComboBoxItem Tag="" AutomationProperties.Name="language.system" />
                    <ComboBoxItem Tag="en" AutomationProperties.Name="language.english" />
                    <ComboBoxItem Tag="hu" AutomationProperties.Name="language.hungarian" />
                    <ComboBoxItem Tag="es" AutomationProperties.Name="language.spanish" />
                </ComboBox>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="12">
                <TextBlock Tag="section.connection" Style="{StaticResource SectionTitleStyle}" />
                <ToggleSwitch x:Name="AutoResolveAdbToggle" Tag="setting.resolve_adb" IsOn="True" />
                <TextBlock Tag="setting.resolve_adb_hint" Style="{StaticResource CaptionStyle}" />
                <ToggleSwitch x:Name="StopAdbToggle" Tag="setting.stop_adb_always" IsOn="False" />
                <TextBlock Tag="setting.stop_adb_hint" Style="{StaticResource CaptionStyle}" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="12">
                <TextBlock Tag="section.rom_matching" Style="{StaticResource SectionTitleStyle}" />
                <ComboBox x:Name="RegionProfilePicker" Tag="label.region_profile" SelectionChanged="RegionProfilePicker_SelectionChanged">
                    <ComboBoxItem Tag="" AutomationProperties.Name="profile.auto" />
                    <ComboBoxItem Tag="global" AutomationProperties.Name="region.global" />
                    <ComboBoxItem Tag="eea" AutomationProperties.Name="region.eea" />
                    <ComboBoxItem Tag="in" AutomationProperties.Name="region.india" />
                    <ComboBoxItem Tag="ru" AutomationProperties.Name="region.russia" />
                    <ComboBoxItem Tag="id" AutomationProperties.Name="region.indonesia" />
                    <ComboBoxItem Tag="tr" AutomationProperties.Name="region.turkey" />
                    <ComboBoxItem Tag="tw" AutomationProperties.Name="region.taiwan" />
                    <ComboBoxItem Tag="cn" AutomationProperties.Name="region.china" />
                </ComboBox>
                <TextBox x:Name="CodenameText" Tag="label.codename" PlaceholderText="garnet" TextChanged="CodenameText_TextChanged" />
                <TextBlock Tag="setting.profile_hint" Style="{StaticResource CaptionStyle}" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="6">
                <TextBlock x:Name="AboutVersionText" Tag="app.title" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Tag="about.description" Style="{StaticResource CaptionStyle}" />
                <TextBlock Tag="about.publisher" Style="{StaticResource CaptionStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <HyperlinkButton Tag="about.website" NavigateUri="https://chromatic.hu" />
                    <HyperlinkButton Tag="about.feedback" NavigateUri="mailto:feedback@chromatic.hu" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</ScrollViewer>
            </Grid>
        </controls:NavigationView>
    </Grid>
</Window>
