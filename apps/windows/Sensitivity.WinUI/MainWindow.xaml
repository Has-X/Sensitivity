<Window
    x:Class="Sensitivity.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE896;" FontSize="16" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Margin="10,0,0,0" Tag="app.title" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Grid>

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Left"
            OpenPaneLength="220"
            SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem AutomationProperties.Name="nav.overview" Tag="overview">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.Name="nav.flash" Tag="flash">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Download" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.Name="nav.recovery" Tag="recovery">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Repair" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem AutomationProperties.Name="nav.diagnostics" Tag="diagnostics">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="View" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <InfoBar
                    x:Name="StatusBar"
                    Margin="24,16,24,0"
                    VerticalAlignment="Top"
                    IsOpen="False"
                    IsClosable="True" />

                <ScrollViewer x:Name="OverviewPage" Padding="32,72,32,32">
                    <StackPanel MaxWidth="980" HorizontalAlignment="Left" Spacing="20">
                        <StackPanel Spacing="6">
                            <TextBlock Tag="page.overview" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Tag="page.overview_intro" Style="{StaticResource CaptionStyle}" MaxWidth="720" />
                        </StackPanel>

                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" CornerRadius="24" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <FontIcon Glyph="&#xE7F8;" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock x:Name="ConnectionTitle" Tag="connection.none" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock x:Name="ConnectionSubtitle" Tag="connection.refresh_hint" Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                                <Button Grid.Column="2" x:Name="RefreshButton" Click="RefreshButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Refresh" />
                                        <TextBlock Tag="action.refresh" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="16">
                                    <TextBlock Tag="section.selected_recovery" Style="{StaticResource SectionTitleStyle}" />
                                    <ComboBox x:Name="DevicePicker" Tag="label.usb_interface" DisplayMemberPath="DisplayName" SelectionChanged="DevicePicker_SelectionChanged" />
                                    <Button x:Name="ReadInfoButton" Tag="action.read_device" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Click="ReadInfoButton_Click" />
                                    <Grid RowSpacing="10" ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Tag="label.device" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" x:Name="DeviceNameText" Text="—" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="1" Tag="label.version" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="VersionText" Text="—" />
                                        <TextBlock Grid.Row="2" Tag="label.region" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="RegionText" Text="—" />
                                        <TextBlock Grid.Row="3" Tag="label.serial" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SerialText" Text="—" FontFamily="Consolas" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="14">
                                    <TextBlock Tag="section.before_flash" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Tag="guide.rom" TextWrapping="Wrap" />
                                    <TextBlock Tag="guide.awake" TextWrapping="Wrap" />
                                    <TextBlock Tag="guide.wipe" TextWrapping="Wrap" />
                                    <Button Tag="action.choose_rom" HorizontalAlignment="Left" Click="GoToFlash_Click" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="FlashPage" Padding="32,72,32,32" Visibility="Collapsed">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left" Spacing="20">
                        <StackPanel Spacing="6">
                            <TextBlock Tag="page.flash" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Tag="page.flash_intro" Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="16">
                                <TextBlock Tag="section.recovery_rom" Style="{StaticResource SectionTitleStyle}" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="RomPathText" Tag="rom.none" IsReadOnly="True" />
                                    <Button Grid.Column="1" Tag="action.browse" Click="BrowseRomButton_Click" />
                                </Grid>
                                <TextBlock Tag="rom.only_official" Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <TextBlock Tag="section.flash_progress" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock x:Name="ProgressPercentText" Text="" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock x:Name="OperationStatusText" Tag="status.ready" Style="{StaticResource CaptionStyle}" />
                                <ProgressBar x:Name="FlashProgress" Minimum="0" Maximum="100" Value="0" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="StartFlashButton" Tag="action.review_flash" Style="{StaticResource AccentButtonStyle}" Click="StartFlashButton_Click" />
                                    <Button x:Name="CancelFlashButton" Tag="action.cancel_safely" IsEnabled="False" Click="CancelFlashButton_Click" />
                                    <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="RecoveryPage" Padding="32,72,32,32" Visibility="Collapsed">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left" Spacing="20">
                        <StackPanel Spacing="6">
                            <TextBlock Tag="page.recovery" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Tag="page.recovery_intro" Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Tag="section.reboot_phone" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Tag="reboot.exit_hint" Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                                <Button Grid.Column="1" Tag="action.reboot" Click="RebootButton_Click" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" BorderBrush="{ThemeResource SystemFillColorCriticalBrush}">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Tag="section.erase_data" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Tag="erase.warning_short" Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                                <Button Grid.Column="1" Tag="action.erase_data_short" Click="EraseDataButton_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="DiagnosticsPage" Padding="32,72,32,32" Visibility="Collapsed">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left" Spacing="20">
                        <StackPanel Spacing="6">
                            <TextBlock Tag="page.diagnostics" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Tag="page.diagnostics_intro" Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Tag="action.run_diagnostics" Style="{StaticResource AccentButtonStyle}" Click="RunDoctorButton_Click" />
                                    <Button Tag="action.copy_report" Click="CopyDiagnosticsButton_Click" />
                                </StackPanel>
                                <TextBox x:Name="DiagnosticsText" Tag="diagnostics.none" MinHeight="260" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsPage" Padding="32,72,32,32" Visibility="Collapsed">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left" Spacing="20">
                        <StackPanel Spacing="6">
                            <TextBlock Tag="page.settings" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Tag="page.settings_intro" Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="18">
                                <ToggleSwitch x:Name="AutoResolveAdbToggle" Tag="setting.resolve_adb" IsOn="True" />
                                <TextBlock Tag="setting.resolve_adb_hint" Style="{StaticResource CaptionStyle}" />
                                <ToggleSwitch x:Name="StopAdbToggle" Tag="setting.stop_adb_always" IsOn="False" />
                                <TextBlock Tag="setting.stop_adb_hint" Style="{StaticResource CaptionStyle}" />
                                <ComboBox x:Name="LanguagePicker" Tag="label.language" SelectionChanged="LanguagePicker_SelectionChanged">
                                    <ComboBoxItem Tag="" AutomationProperties.Name="language.system" />
                                    <ComboBoxItem Tag="en" AutomationProperties.Name="language.english" />
                                    <ComboBoxItem Tag="hu" AutomationProperties.Name="language.hungarian" />
                                    <ComboBoxItem Tag="es" AutomationProperties.Name="language.spanish" />
                                </ComboBox>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="AboutVersionText" Tag="app.title" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Tag="about.description" Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
