<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Sensitivity.WinUI</RootNamespace>
    <AssemblyName>Sensitivity</AssemblyName>
    <Version>1.1.2</Version>
    <ApplicationIcon>..\..\..\installer\assets\app.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <Content Include="Resources\windows-*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\assets\sensitivity-icon.png" Link="Assets\SensitivityIcon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Windows App SDK 2.x does not currently copy the generated app PRI to an
       unpackaged publish directory. Without it, WinUI fails fast at startup. -->
  <Target Name="CopyAppPriToPublish" AfterTargets="Publish">
    <Copy
      SourceFiles="$(TargetDir)$(AssemblyName).pri"
      DestinationFolder="$(PublishDir)"
      Condition="Exists('$(TargetDir)$(AssemblyName).pri')" />
  </Target>
</Project>
